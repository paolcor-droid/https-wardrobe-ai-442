# Copy to .env.staging OUTSIDE Git history. Never commit real values.
MONGO_URL=mongodb+srv://REPLACE_WITH_SECRET@cluster.example.invalid/lumiere_staging
DB_NAME=lumiere_staging
LUMIERE_PHOTO_STORAGE=s3
LUMIERE_LOCAL_IMAGE_STORAGE=0
LUMIERE_CORS_ORIGINS=https://YOUR_PRIVATE_STAGING_DOMAIN
OPENAI_API_KEY=REPLACE_WITH_SECRET
# Add the required private photo provider configuration and other backend
# secrets using your hosting platform's secret manager, not Git.
