# LUMIÈRE environment configuration
# Copy the variable NAMES into the target environment and set values there.
# Never commit real credentials or secret values to GitHub.

# Required: backend database
# MongoDB connection string used by Motor/AsyncIOMotorClient.
MONGO_URL=

# Required: database name within the MongoDB deployment.
DB_NAME=

# Required for AI features and Emergent object-storage initialization.
# Used server-side only for Claude/OpenAI/Gemini via emergentintegrations and
# for obtaining an object-storage key. Do not expose this to the frontend.
EMERGENT_LLM_KEY=

# Optional: Emergent integrations proxy base URL.
# Leave unset to use https://integrations.emergentagent.com
INTEGRATION_PROXY_URL=

# Required by the Expo frontend.
# Public base URL of this workspace's LUMIÈRE backend, with no trailing /api.
EXPO_PUBLIC_BACKEND_URL=

# Matterhorn note:
# The current trial uses a small source-backed snapshot committed in code.
# No Matterhorn API secret is required for this trial.
# A future live catalogue sync should use a server-side secret such as:
# MATTERHORN_API_KEY=
